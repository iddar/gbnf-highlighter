{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "gbnf",
  "scopeName": "source.gbnf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#variables" },
    { "include": "#assignment" },
    { "include": "#strings" },
    { "include": "#character-class" },
    { "include": "#quantifiers" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#whitespace" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.gbnf",
      "begin": "#",
      "end": "$"
    },
    "variables": {
      "name": "entity.name.function.gbnf",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b(?=\\s*::=)"
    },
    "assignment": {
      "name": "keyword.operator.assignment.gbnf",
      "match": "::="
    },
    "strings": {
      "name": "string.quoted.double.gbnf",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gbnf",
          "match": "\\\\[\"\\\\\/bfnrt]|\\\\u[0-9a-fA-F]{4}"
        }
      ]
    },
    "character-class": {
      "name": "constant.character.character-class.gbnf",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "constant.character.escape.gbnf",
          "match": "\\\\."
        },
        {
          "name": "constant.other.range.gbnf",
          "match": "[^\\]\\\\]-[^\\]\\\\]"
        }
      ]
    },
    "quantifiers": {
      "name": "keyword.operator.quantifier.gbnf",
      "match": "[*+?]"
    },
    "operators": {
      "name": "keyword.operator.gbnf",
      "match": "[|(){}]"
    },
    "identifiers": {
      "name": "variable.other.gbnf",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b"
    },
    "whitespace": {
      "name": "support.variable.gbnf",
      "match": "\\bws\\b"
    }
  }
}
